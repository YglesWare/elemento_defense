<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 9 et plus : le jeu dessine aussi sous l'encoche de l'appareil photo. Sans ça, en plein écran, les
         Android anciens (14 et moins) gardent une bande unie en haut ; le contenu s'en écarte (css/style.css, variable sat).
         Mêmes thèmes que values/styles.xml, avec ce réglage en plus (la fenêtre naît avec le thème de démarrage). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
