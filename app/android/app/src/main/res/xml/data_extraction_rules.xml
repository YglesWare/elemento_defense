<?xml version="1.0" encoding="utf-8"?>
<!-- Sauvegarde Android (Android 12 et plus) et transfert vers un nouveau téléphone : comme backup_rules.xml -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="app_webview/Default/Local Storage/" />
    <exclude domain="root" path="app_webview/Default/Session Storage/" />
    <exclude domain="root" path="app_webview/Default/Cookies" />
    <exclude domain="root" path="app_webview/Default/Cookies-journal" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="app_webview/Default/Local Storage/" />
    <exclude domain="root" path="app_webview/Default/Session Storage/" />
    <exclude domain="root" path="app_webview/Default/Cookies" />
    <exclude domain="root" path="app_webview/Default/Cookies-journal" />
  </device-transfer>
</data-extraction-rules>
